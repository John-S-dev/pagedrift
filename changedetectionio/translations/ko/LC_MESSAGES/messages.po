msgstr "백업 zip 파일"

#: changedetectionio/blueprint/backups/restore.py
msgid "Must be a .zip backup file!"
msgstr ".zip 백업 파일이어야 합니다."

#: changedetectionio/blueprint/backups/restore.py
msgid "Include groups"
msgstr "그룹 포함"

